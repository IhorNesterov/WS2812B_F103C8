 278:Core/Src/WS2812b_Core.c **** 	// Is this the last LED?
 279:Core/Src/WS2812b_Core.c **** 	if(ws2812b.repeatCounter != (WS2812B_NUMBER_OF_LEDS / 2 - 1))
 280:Core/Src/WS2812b_Core.c **** 	{
 281:Core/Src/WS2812b_Core.c **** 		uint32_t i;
 282:Core/Src/WS2812b_Core.c **** 
 283:Core/Src/WS2812b_Core.c **** 		for( i = 0; i < WS2812_BUFFER_COUNT; i++ )
 284:Core/Src/WS2812b_Core.c **** 		{
 285:Core/Src/WS2812b_Core.c **** 			loadNextFramebufferData(&ws2812b.item[i], 0);
 286:Core/Src/WS2812b_Core.c **** 		}
 287:Core/Src/WS2812b_Core.c **** 
 288:Core/Src/WS2812b_Core.c **** 	} else {
 289:Core/Src/WS2812b_Core.c **** 		// If this is the last pixel, set the next pixel value to zeros, because
 290:Core/Src/WS2812b_Core.c **** 		// the DMA would not stop exactly at the last bit.
 291:Core/Src/WS2812b_Core.c **** 		ws2812b_set_pixel(0, 0, 0, 0, 0);
 292:Core/Src/WS2812b_Core.c **** 	}
 293:Core/Src/WS2812b_Core.c **** 
 294:Core/Src/WS2812b_Core.c **** 	#if defined(LED4_PORT)
