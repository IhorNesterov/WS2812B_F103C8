 348:Core/Src/WS2812b_Core.c **** // TIM2 Interrupt Handler gets executed on every TIM2 Update if enabled
 349:Core/Src/WS2812b_Core.c **** void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
 350:Core/Src/WS2812b_Core.c **** {
 351:Core/Src/WS2812b_Core.c **** 	// I have to wait 50us to generate Treset signal
 352:Core/Src/WS2812b_Core.c **** 	if (ws2812b.timerPeriodCounter < (uint8_t)WS2812_RESET_PERIOD)
 353:Core/Src/WS2812b_Core.c **** 	{
 354:Core/Src/WS2812b_Core.c **** 		// count the number of timer periods
 355:Core/Src/WS2812b_Core.c **** 		ws2812b.timerPeriodCounter++;
 356:Core/Src/WS2812b_Core.c **** 	}
 357:Core/Src/WS2812b_Core.c **** 	else
 358:Core/Src/WS2812b_Core.c **** 	{
 359:Core/Src/WS2812b_Core.c **** 		ws2812b.timerPeriodCounter = 0;
 360:Core/Src/WS2812b_Core.c **** 		__HAL_TIM_DISABLE(&Tim2Handle);
 361:Core/Src/WS2812b_Core.c **** 		TIM2->CR1 = 0; // disable timer
 362:Core/Src/WS2812b_Core.c **** 
 363:Core/Src/WS2812b_Core.c **** 		// disable the TIM2 Update
 364:Core/Src/WS2812b_Core.c **** 		__HAL_TIM_DISABLE_IT(&Tim2Handle, TIM_IT_UPDATE);
 365:Core/Src/WS2812b_Core.c **** 		// set TransferComplete flag
 366:Core/Src/WS2812b_Core.c **** 		ws2812b.transferComplete = 1;
 367:Core/Src/WS2812b_Core.c **** 	}
 368:Core/Src/WS2812b_Core.c **** 
 369:Core/Src/WS2812b_Core.c **** }
