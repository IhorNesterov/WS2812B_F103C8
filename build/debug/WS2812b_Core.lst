 272:Core/Src/WS2812b_Core.c **** void DMA_TransferHalfHandler(DMA_HandleTypeDef *DmaHandle)
 273:Core/Src/WS2812b_Core.c **** {
 274:Core/Src/WS2812b_Core.c **** 	#if defined(LED4_PORT)
 275:Core/Src/WS2812b_Core.c **** 		LED4_PORT->BSRR = LED4_PIN;
 276:Core/Src/WS2812b_Core.c **** 	#endif
 277:Core/Src/WS2812b_Core.c **** 
 278:Core/Src/WS2812b_Core.c **** 	// Is this the last LED?
 279:Core/Src/WS2812b_Core.c **** 	if(ws2812b.repeatCounter != (WS2812B_NUMBER_OF_LEDS / 2 - 1))
 280:Core/Src/WS2812b_Core.c **** 	{
 281:Core/Src/WS2812b_Core.c **** 		uint32_t i;
 282:Core/Src/WS2812b_Core.c **** 
 283:Core/Src/WS2812b_Core.c **** 		for( i = 0; i < WS2812_BUFFER_COUNT; i++ )
 284:Core/Src/WS2812b_Core.c **** 		{
 285:Core/Src/WS2812b_Core.c **** 			loadNextFramebufferData(&ws2812b.item[i], 0);
 286:Core/Src/WS2812b_Core.c **** 		}
 287:Core/Src/WS2812b_Core.c **** 
 288:Core/Src/WS2812b_Core.c **** 	} else {
 289:Core/Src/WS2812b_Core.c **** 		// If this is the last pixel, set the next pixel value to zeros, because
 290:Core/Src/WS2812b_Core.c **** 		// the DMA would not stop exactly at the last bit.
 291:Core/Src/WS2812b_Core.c **** 		ws2812b_set_pixel(0, 0, 0, 0, 0);
 292:Core/Src/WS2812b_Core.c **** 	}
 293:Core/Src/WS2812b_Core.c **** 
 294:Core/Src/WS2812b_Core.c **** 	#if defined(LED4_PORT)
 295:Core/Src/WS2812b_Core.c **** 		LED4_PORT->BRR = LED4_PIN;
 296:Core/Src/WS2812b_Core.c **** 	#endif
 297:Core/Src/WS2812b_Core.c **** }
 298:Core/Src/WS2812b_Core.c **** 
 299:Core/Src/WS2812b_Core.c **** void DMA_TransferCompleteHandler(DMA_HandleTypeDef *DmaHandle)
 300:Core/Src/WS2812b_Core.c **** {
 301:Core/Src/WS2812b_Core.c **** 	#if defined(LED5_PORT)
 302:Core/Src/WS2812b_Core.c **** 		LED5_PORT->BSRR = LED5_PIN;
 303:Core/Src/WS2812b_Core.c **** 	#endif
 304:Core/Src/WS2812b_Core.c **** 
 305:Core/Src/WS2812b_Core.c **** 	ws2812b.repeatCounter++;
 306:Core/Src/WS2812b_Core.c **** 
 307:Core/Src/WS2812b_Core.c **** 	if(ws2812b.repeatCounter == WS2812B_NUMBER_OF_LEDS / 2)
 308:Core/Src/WS2812b_Core.c **** 	{
 309:Core/Src/WS2812b_Core.c **** 		// Transfer of all LEDs is done, disable DMA but enable tiemr update IRQ to stop the 50us pulse
 310:Core/Src/WS2812b_Core.c **** 		ws2812b.repeatCounter = 0;
 311:Core/Src/WS2812b_Core.c **** 
 312:Core/Src/WS2812b_Core.c **** 		// Enable TIM2 Update interrupt for 50us Treset signal
 313:Core/Src/WS2812b_Core.c **** 		__HAL_TIM_ENABLE_IT(&Tim2Handle, TIM_IT_UPDATE);
 314:Core/Src/WS2812b_Core.c **** 		// Disable DMA
 315:Core/Src/WS2812b_Core.c **** 		__HAL_DMA_DISABLE(&dmaUpdate);
 316:Core/Src/WS2812b_Core.c **** 		__HAL_DMA_DISABLE(&dmaCC1);
 317:Core/Src/WS2812b_Core.c **** 		__HAL_DMA_DISABLE(&dmaCC2);
