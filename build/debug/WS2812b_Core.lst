 208:Core/Src/WS2812b_Core.c **** 
 209:Core/Src/WS2812b_Core.c **** static void loadNextFramebufferData(WS2812_BufferItem *bItem, uint32_t row)
 210:Core/Src/WS2812b_Core.c **** {
 211:Core/Src/WS2812b_Core.c **** 
 212:Core/Src/WS2812b_Core.c **** 	uint32_t r = bItem->frameBufferPointer[bItem->frameBufferCounter++];
 213:Core/Src/WS2812b_Core.c **** 	uint32_t g = bItem->frameBufferPointer[bItem->frameBufferCounter++];
 214:Core/Src/WS2812b_Core.c **** 	uint32_t b = bItem->frameBufferPointer[bItem->frameBufferCounter++];
 215:Core/Src/WS2812b_Core.c **** 
 216:Core/Src/WS2812b_Core.c **** 	if(bItem->frameBufferCounter == bItem->frameBufferSize)
 217:Core/Src/WS2812b_Core.c **** 		bItem->frameBufferCounter = 0;
 218:Core/Src/WS2812b_Core.c **** 
 219:Core/Src/WS2812b_Core.c **** 	ws2812b_set_pixel(bItem->channel, row, r, g, b);
 220:Core/Src/WS2812b_Core.c **** }
 221:Core/Src/WS2812b_Core.c **** 
 222:Core/Src/WS2812b_Core.c **** 
 223:Core/Src/WS2812b_Core.c **** // Transmit the framebuffer
 224:Core/Src/WS2812b_Core.c **** static void WS2812_sendbuf()
 225:Core/Src/WS2812b_Core.c **** {
 226:Core/Src/WS2812b_Core.c **** 	// transmission complete flag
 227:Core/Src/WS2812b_Core.c **** 	ws2812b.transferComplete = 0;
 228:Core/Src/WS2812b_Core.c **** 
 229:Core/Src/WS2812b_Core.c **** 	uint32_t i;
 230:Core/Src/WS2812b_Core.c **** 
 231:Core/Src/WS2812b_Core.c **** 	for( i = 0; i < WS2812_BUFFER_COUNT; i++ )
 232:Core/Src/WS2812b_Core.c **** 	{
 233:Core/Src/WS2812b_Core.c **** 		ws2812b.item[i].frameBufferCounter = 0;
 234:Core/Src/WS2812b_Core.c **** 
 235:Core/Src/WS2812b_Core.c **** 		loadNextFramebufferData(&ws2812b.item[i], 0); // ROW 0
 236:Core/Src/WS2812b_Core.c **** 		loadNextFramebufferData(&ws2812b.item[i], 1); // ROW 0
 237:Core/Src/WS2812b_Core.c **** 	}
 238:Core/Src/WS2812b_Core.c **** 
 239:Core/Src/WS2812b_Core.c **** 	// clear all DMA flags
 240:Core/Src/WS2812b_Core.c **** 	__HAL_DMA_CLEAR_FLAG(&dmaUpdate, DMA_FLAG_TC2 | DMA_FLAG_HT2 | DMA_FLAG_TE2);
 241:Core/Src/WS2812b_Core.c **** 	__HAL_DMA_CLEAR_FLAG(&dmaCC1, DMA_FLAG_TC5 | DMA_FLAG_HT5 | DMA_FLAG_TE5);
 242:Core/Src/WS2812b_Core.c **** 	__HAL_DMA_CLEAR_FLAG(&dmaCC2, DMA_FLAG_TC7 | DMA_FLAG_HT7 | DMA_FLAG_TE7);
 243:Core/Src/WS2812b_Core.c **** 
 244:Core/Src/WS2812b_Core.c **** 	// configure the number of bytes to be transferred by the DMA controller
 245:Core/Src/WS2812b_Core.c **** 	dmaUpdate.Instance->CNDTR = BUFFER_SIZE;
 246:Core/Src/WS2812b_Core.c **** 	dmaCC1.Instance->CNDTR = BUFFER_SIZE;
 247:Core/Src/WS2812b_Core.c **** 	dmaCC2.Instance->CNDTR = BUFFER_SIZE;
