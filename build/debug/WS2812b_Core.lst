 540:Core/Src/WS2812b_Core.c **** 
 541:Core/Src/WS2812b_Core.c **** 
 542:Core/Src/WS2812b_Core.c **** /* How many channels (strips) of LEDs we want to control. This must not exceed 16. */
 543:Core/Src/WS2812b_Core.c **** #define WS2812_NUM_CHANNELS     16
 544:Core/Src/WS2812b_Core.c **** 
 545:Core/Src/WS2812b_Core.c **** /* If all your channel framebuffers are the same size (ie, if each channel has the same number
 546:Core/Src/WS2812b_Core.c ****  * of pixels), you can set this to 1 to bypass some error checking. This will speed things up
 547:Core/Src/WS2812b_Core.c ****  * substantially, potentially allowing you to slow down your CPU and still meet the WS2812
 548:Core/Src/WS2812b_Core.c ****  * timing requirements. "If unsure, set this to 0".
 549:Core/Src/WS2812b_Core.c ****  */
 550:Core/Src/WS2812b_Core.c **** #define WS212_ALL_CHANNELS_SAME_LENGTH  0
 551:Core/Src/WS2812b_Core.c **** 
 552:Core/Src/WS2812b_Core.c **** /*
ARM GAS  C:\Users\igorn\AppData\Local\Temp\ccU4VXWS.s 			page 15


 553:Core/Src/WS2812b_Core.c ****  * We support up to 16 LED channels (that is, up to 16 distinct strips of LEDs.
 554:Core/Src/WS2812b_Core.c ****  * Channels must be used sequentially, but their GPIOs do not have to be sequential.
 555:Core/Src/WS2812b_Core.c ****  * Although all the LED strips must be on the same GPIO bank, the channel number does not
 556:Core/Src/WS2812b_Core.c ****  * necessarily have to match its GPIO number. This is useful if we want fewer than 16 channels,
 557:Core/Src/WS2812b_Core.c ****  * but we don't want them to start from GPIO 0.
 558:Core/Src/WS2812b_Core.c ****  *
 559:Core/Src/WS2812b_Core.c ****  * Change these assignments based on which strip you are wiring to which GPIO.
 560:Core/Src/WS2812b_Core.c ****  *
 561:Core/Src/WS2812b_Core.c ****  * To change the GPIO associated with each channel, modify the code below:
 562:Core/Src/WS2812b_Core.c ****  */
 563:Core/Src/WS2812b_Core.c **** #define WS2812_CH0_GPIO      0
 564:Core/Src/WS2812b_Core.c **** #define WS2812_CH1_GPIO      1
 565:Core/Src/WS2812b_Core.c **** #define WS2812_CH2_GPIO      2
 566:Core/Src/WS2812b_Core.c **** #define WS2812_CH3_GPIO      3
 567:Core/Src/WS2812b_Core.c **** #define WS2812_CH4_GPIO      4
 568:Core/Src/WS2812b_Core.c **** #define WS2812_CH5_GPIO      5
 569:Core/Src/WS2812b_Core.c **** #define WS2812_CH6_GPIO      6
 570:Core/Src/WS2812b_Core.c **** #define WS2812_CH7_GPIO      7
 571:Core/Src/WS2812b_Core.c **** #define WS2812_CH8_GPIO      8
 572:Core/Src/WS2812b_Core.c **** #define WS2812_CH9_GPIO      9
 573:Core/Src/WS2812b_Core.c **** #define WS2812_CH10_GPIO    10
 574:Core/Src/WS2812b_Core.c **** #define WS2812_CH11_GPIO    11
 575:Core/Src/WS2812b_Core.c **** #define WS2812_CH12_GPIO    12
 576:Core/Src/WS2812b_Core.c **** #define WS2812_CH13_GPIO    13
 577:Core/Src/WS2812b_Core.c **** #define WS2812_CH14_GPIO    14
 578:Core/Src/WS2812b_Core.c **** #define WS2812_CH15_GPIO    15
 579:Core/Src/WS2812b_Core.c **** 
 580:Core/Src/WS2812b_Core.c **** /*
 581:Core/Src/WS2812b_Core.c ****  * Unpack the bits of ch_val and pack them into the bit positions of cur0-cur7 that correspond to
 582:Core/Src/WS2812b_Core.c ****  * the given GPIO number. Later, cur0-cur7 will be DMAed directly to a register within our GPIO
 583:Core/Src/WS2812b_Core.c ****  * bank.
 584:Core/Src/WS2812b_Core.c ****  */
 585:Core/Src/WS2812b_Core.c **** #define UNPACK_CHANNEL(gpio_num)                    \
 586:Core/Src/WS2812b_Core.c ****     asm volatile (                                  \
 587:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #7, #1 \n"               \
 588:Core/Src/WS2812b_Core.c ****     "bfi    %[cur0], r0,   #" #gpio_num ", 1  \n"   \
 589:Core/Src/WS2812b_Core.c ****                                                     \
 590:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #6, #1 \n"               \
 591:Core/Src/WS2812b_Core.c ****     "bfi    %[cur1], r0,   #" #gpio_num ", 1  \n"   \
 592:Core/Src/WS2812b_Core.c ****                                                     \
 593:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #5, #1 \n"               \
 594:Core/Src/WS2812b_Core.c ****     "bfi    %[cur2], r0,   #" #gpio_num ", 1  \n"   \
 595:Core/Src/WS2812b_Core.c ****                                                     \
 596:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #4, #1 \n"               \
 597:Core/Src/WS2812b_Core.c ****     "bfi    %[cur3], r0,   #" #gpio_num ", 1  \n"   \
 598:Core/Src/WS2812b_Core.c ****                                                     \
 599:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #3, #1 \n"               \
 600:Core/Src/WS2812b_Core.c ****     "bfi    %[cur4], r0,   #" #gpio_num ", 1  \n"   \
 601:Core/Src/WS2812b_Core.c ****                                                     \
 602:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #2, #1 \n"               \
 603:Core/Src/WS2812b_Core.c ****     "bfi    %[cur5], r0,   #" #gpio_num ", 1  \n"   \
 604:Core/Src/WS2812b_Core.c ****                                                     \
 605:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #1, #1 \n"               \
 606:Core/Src/WS2812b_Core.c ****     "bfi    %[cur6], r0,   #" #gpio_num ", 1  \n"   \
 607:Core/Src/WS2812b_Core.c ****                                                     \
 608:Core/Src/WS2812b_Core.c ****     "ubfx   r0, %[ch_val], #0, #1 \n"               \
 609:Core/Src/WS2812b_Core.c ****     "bfi    %[cur7], r0,   #" #gpio_num ", 1  \n"   \
ARM GAS  C:\Users\igorn\AppData\Local\Temp\ccU4VXWS.s 			page 16


 610:Core/Src/WS2812b_Core.c ****                                                     \
 611:Core/Src/WS2812b_Core.c ****     : [cur0]"+r" (cur0),                            \
 612:Core/Src/WS2812b_Core.c ****         [cur1]"+r" (cur1),                          \
 613:Core/Src/WS2812b_Core.c ****         [cur2]"+r" (cur2),                          \
 614:Core/Src/WS2812b_Core.c ****         [cur3]"+r" (cur3),                          \
 615:Core/Src/WS2812b_Core.c ****         [cur4]"+r" (cur4),                          \
 616:Core/Src/WS2812b_Core.c ****         [cur5]"+r" (cur5),                          \
 617:Core/Src/WS2812b_Core.c ****         [cur6]"+r" (cur6),                          \
 618:Core/Src/WS2812b_Core.c ****         [cur7]"+r" (cur7)                           \
 619:Core/Src/WS2812b_Core.c ****     : [ch_val]"r" (ch_val)                          \
 620:Core/Src/WS2812b_Core.c ****     : "r0", "cc");  /* r0 is a temp variable */
 621:Core/Src/WS2812b_Core.c **** 
 622:Core/Src/WS2812b_Core.c **** 
 623:Core/Src/WS2812b_Core.c **** 
 624:Core/Src/WS2812b_Core.c **** /*
 625:Core/Src/WS2812b_Core.c ****  * Unpack the bits for one byte of one channel, and pack them into the bit positions of
 626:Core/Src/WS2812b_Core.c ****  * the cur0 - cur7 variables, corresponding to the GPIO number for that channel.
 627:Core/Src/WS2812b_Core.c ****  * The 'if' statement will be optimized away by the compiler, depending on how many channels
 628:Core/Src/WS2812b_Core.c ****  * are actually defined.
 629:Core/Src/WS2812b_Core.c ****  */
 630:Core/Src/WS2812b_Core.c **** #define HANDLE_CHANNEL(ch_num, gpio_num)                    \
 631:Core/Src/WS2812b_Core.c ****     if (ch_num < WS2812_NUM_CHANNELS) {                     \
 632:Core/Src/WS2812b_Core.c ****         ch_val = 0xaa; /*get_channel_byte(channels + ch_num, pos);*/  \
 633:Core/Src/WS2812b_Core.c ****         UNPACK_CHANNEL(gpio_num);                           \
 634:Core/Src/WS2812b_Core.c ****     }
 635:Core/Src/WS2812b_Core.c **** 
 636:Core/Src/WS2812b_Core.c **** 	uint8_t channel = row;
 637:Core/Src/WS2812b_Core.c **** 	uint16_t led_index = column;
 638:Core/Src/WS2812b_Core.c **** 
 639:Core/Src/WS2812b_Core.c **** 	register uint16_t cur0 = 0, cur1 = 0, cur2 = 0, cur3 = 0, cur4 = 0, cur5 = 0, cur6 = 0, cur7 = 0;
 640:Core/Src/WS2812b_Core.c **** 
 641:Core/Src/WS2812b_Core.c ****     uint8_t ch_val;
 642:Core/Src/WS2812b_Core.c ****     HANDLE_CHANNEL( 0, WS2812_CH0_GPIO);
 643:Core/Src/WS2812b_Core.c ****     HANDLE_CHANNEL( 1, WS2812_CH1_GPIO);
 644:Core/Src/WS2812b_Core.c ****     HANDLE_CHANNEL( 2, WS2812_CH2_GPIO);
 645:Core/Src/WS2812b_Core.c **** 
 646:Core/Src/WS2812b_Core.c **** 
 647:Core/Src/WS2812b_Core.c ****     /*
 648:Core/Src/WS2812b_Core.c ****      * Store the repacked bits in our DMA buffer, ready to be sent to the GPIO bit-reset register.
 649:Core/Src/WS2812b_Core.c ****      * cur0-cur7 represents bits0 - bits7 of all our channels. Each bit within curX is one channel.
 650:Core/Src/WS2812b_Core.c ****      */
 651:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[0] = cur0;
 652:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[1] = cur1;
 653:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[2] = cur2;
 654:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[3] = cur3;
 655:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[4] = cur4;
 656:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[5] = cur5;
 657:Core/Src/WS2812b_Core.c ****     ws2812bDmaBitBuffer[6] = cur6;
