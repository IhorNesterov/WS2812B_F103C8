 306:Core/Src/WS2812b_Core.c **** 
 307:Core/Src/WS2812b_Core.c **** 	if(ws2812b.repeatCounter == WS2812B_NUMBER_OF_LEDS / 2)
 308:Core/Src/WS2812b_Core.c **** 	{
